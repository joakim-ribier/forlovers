---
/**
 * The whole home page for one locale. Each locale route (/, later /fr/)
 * renders <Home locale="…" />, so pages never hold any text themselves.
 */
import Base from '../layouts/Base.astro';
import NeonHeart from './NeonHeart.astro';
import AppList from './AppList.astro';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Base locale={locale}>
  <div class="page">
    <header class="top wrap">
      <a class="wordmark" href="/">
        <img src="/favicon.svg" alt="" width="28" height="28" />
        <span>forlovers<span class="tld">.app</span></span>
      </a>
      <a class="nav" href="https://github.com/joakim-ribier/forlovers" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
        <span>{t('nav.github')}</span>
      </a>
    </header>

    <main class="hero">
      <div class="stage"><NeonHeart /></div>
      <!-- Phone and tablet: stacked and centred. Desktop: manifesto left, apps right. -->
      <div class="lower wrap">
        <div class="words">
          <h1>{t('manifesto.title')}</h1>
          <p>{t('manifesto.body')}</p>
        </div>
        <AppList locale={locale} />
      </div>
    </main>
  </div>
</Base>

<style>
  .page {
    position: relative;
    z-index: 1;
    overflow-x: clip;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding-top: max(22px, env(safe-area-inset-top, 0px));
  }

  .wordmark {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .wordmark img {
    border-radius: 7px;
  }

  .tld {
    color: var(--neon);
  }

  .nav {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink-soft);
    font-size: 15px;
    text-decoration: none;
  }

  .nav:hover {
    color: var(--ink);
  }

  .hero {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* The heart's line runs edge to edge, so the stage ignores the gutters. */
  .stage {
    position: relative;
    height: clamp(210px, 36svh, 400px);
  }

  /* Short tablet screens: give the height back to the app list. */
  @media (min-width: 761px) and (max-width: 1099px) and (max-height: 800px) {
    .stage {
      height: max(200px, 30svh);
    }
  }

  /* A soft pink warmth behind the heart, nothing more. */
  .stage::before {
    content: '';
    position: absolute;
    inset: -10% 0;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--neon) 13%, transparent),
      transparent
    );
    pointer-events: none;
  }

  .lower {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4.5vh, 56px);
    width: 100%;
    padding-bottom: max(28px, env(safe-area-inset-bottom, 0px));
  }

  .words {
    text-align: center;
  }

  h1 {
    max-width: 16ch;
    margin: 0 auto;
    font-size: clamp(36px, 5.6vw, 72px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  p {
    max-width: 46ch;
    margin: 22px auto 0;
    color: var(--ink-soft);
    font-size: clamp(16px, 1.5vw, 19px);
    font-weight: 300;
    text-wrap: pretty;
  }

  /* Desktop: the heart gets its full size back, the apps move beside the manifesto. */
  @media (min-width: 1100px) {
    .stage {
      height: clamp(300px, 46svh, 480px);
    }

    .lower {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      /* The title sits at the top of the row; the apps column stretches to the
         row's height and centres the closed list in it. Opening an app grows the
         row downward, so the title never moves. */
      align-items: start;
      gap: clamp(48px, 6vw, 96px);
      padding-top: 8px;
    }

    .words {
      text-align: left;
    }

    h1,
    p {
      margin-left: 0;
    }

    .lower :global(.apps) {
      width: 100%;
      align-self: stretch;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .lower :global(.apps h2) {
      text-align: left;
    }
  }
</style>
