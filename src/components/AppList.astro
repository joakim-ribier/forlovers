---
/**
 * The apps as a vertical list. Each row opens in place to show what the app
 * does, how to get in, what it's built with and its links. Native <details>:
 * no JavaScript, keyboard friendly, and name="apps" keeps one row open at a time.
 */
import { apps } from '../data/apps';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
---

<section class="apps" aria-labelledby="apps-title">
  <h2 id="apps-title">{t('apps.title')}</h2>
  <div class="list">
    {
      apps.map((app) => (
        <details name="apps" style={`--accent:${app.accent}`}>
          <summary>
            <img src={app.icon} alt="" width="40" height="40" />
            <span class="title">
              <span class="name">{app.name}</span>
              <span class="tagline">{t(app.keys.tagline)}</span>
            </span>
            <span class="toggle" aria-hidden="true" />
          </summary>
          <div class="more">
            <p>{t(app.keys.body)}</p>
            <dl>
              <div>
                <dt>{t('apps.accessLabel')}</dt>
                <dd>{t(app.keys.access)}</dd>
              </div>
              <div>
                <dt>{t('apps.stackLabel')}</dt>
                <dd>{app.stack.join(', ')}</dd>
              </div>
            </dl>
            <div class="links">
              {app.here ? (
                <span class="here">{t('apps.here')}</span>
              ) : (
                <a class="open" href={app.url} target="_blank" rel="noopener noreferrer">
                  {t('apps.open', { name: app.name })}
                </a>
              )}
              {app.source && (
                <a class="source" href={app.source.url} target="_blank" rel="noopener noreferrer">
                  {t('apps.source', { name: app.source.label })}
                </a>
              )}
            </div>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .apps {
    width: min(100%, 600px);
    margin-inline: auto;
  }

  h2 {
    margin: 0 0 12px;
    color: var(--ink-faint);
    font-size: 14px;
    font-weight: 500;
    text-align: center;
  }

  .list {
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }

  details {
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }

  summary {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 6px;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary img {
    flex: none;
    border-radius: 10px;
  }

  .title {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .name {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.25;
  }

  .tagline {
    color: var(--ink-soft);
    font-size: 14px;
    line-height: 1.35;
  }

  /* A plus that turns into a minus when the row is open. */
  .toggle {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 8px;
    transition:
      border-color 0.2s,
      transform 0.25s;
  }

  .toggle::before,
  .toggle::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 10px;
    height: 1.5px;
    background: var(--ink);
    transform: translate(-50%, -50%);
    transition: transform 0.25s;
  }

  .toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  summary:hover .toggle,
  details[open] .toggle {
    border-color: var(--accent);
  }

  details[open] .toggle::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .more {
    padding: 0 6px 20px 60px;
  }

  .more p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 15px;
  }

  dl {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 28px;
    margin: 14px 0 0;
  }

  dt {
    color: var(--ink-faint);
    font-size: 13px;
  }

  dd {
    margin: 0;
    font-size: 14px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 20px;
    margin-top: 18px;
  }

  .open {
    padding: 9px 16px;
    border-radius: 8px;
    background: var(--accent);
    color: #05070c;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  .open:hover {
    background: color-mix(in srgb, var(--accent) 80%, white);
  }

  .here {
    padding: 8px 15px;
    border: 1px solid color-mix(in srgb, var(--accent) 60%, transparent);
    border-radius: 8px;
    color: var(--accent);
    font-size: 14px;
    font-weight: 600;
  }

  .source {
    color: var(--ink-soft);
    font-size: 14px;
    text-underline-offset: 3px;
  }

  .source:hover {
    color: var(--ink);
  }

  @media (max-width: 480px) {
    .more {
      padding-left: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toggle,
    .toggle::before,
    .toggle::after {
      transition: none;
    }
  }
</style>
